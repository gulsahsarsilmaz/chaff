{
  "name": "chaff",
  "version": "0.2.0",
  "description": "Separate the live work from the dead weight on a developer machine: processes, caches, build output, package stores and stale git worktrees, with tiered safe cleanup.",
  "type": "module",
  "bin": {
    "chaff": "./scripts/chaff.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "scripts",
    "commands",
    "hooks",
    ".claude-plugin",
    "settings.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "cleanup",
    "disk-space",
    "monorepo",
    "worktree",
    "cache",
    "daemon",
    "nx",
    "turborepo",
    "cargo",
    "unity",
    "claude-code"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
